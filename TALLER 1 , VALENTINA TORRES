#include<iostream>
#include<string>
using namespace std;

int main (){
    // Declaracion de variables 
    string nombre, direccion ,  telefono ,correo;
    int edad;
    char genero;
    int estrato;
    float peso, altura;
    bool alergias ;  

    // ENTRADA DE DATOS 
    cout << "Nombre completo: ";
    cin.ignore(); // limpiar buffer
    getline (cin , nombre );

    cout << "Edad:";
    cin >> edad;

    cout << "Genero  (M/F/O):";
    cin >> genero;

    cout <<"Estrato socioeconomico: ";
    cin >> estrato;

    cout <<"Peso (Kg):";
    cin >>peso;

    cout << "Altura  (m)";
    cin  >> altura;

    cout  << "Tiene alergias? (1= si , 0= no):";
    cin >> alergias;
    cin.ignore(); // limpiar buffer

    cout << "Direccion:";
    getline(cin, direccion  );


    cout << "Telefono:";
    getline(cin, telefono);

    cout << "Correo:";
    getline(cin, correo);


    // CALCULO DE IMC 
    float imc  = peso  / (peso * altura );
    

    // salida de datos 
    cout << "' \n --- FICHA MEDICA ---\n";
    cout<<"Nombre : " << nombre << endl;
    cout <<"Edad:" << edad << endl ; 
    cout <<"Genero:" << genero << endl;
    cout <<"Estrato:" << estrato << endl;
    cout <<"Peso:" << peso << "Kg" <<endl ;
    cout <<"Altura:" << altura << "m" <<endl  ;
    cout <<"IMC:" << imc << endl;
    cout <<"Alergia:" << (alergias ?  " si" :"no" ) << endl ;
    cout <<"Direccion:" << direccion  << endl;
    cout <<"Telefono:" << telefono << endl;
    cout <<"Correo:" << correo << endl;


}
